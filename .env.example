# QQ邮箱 SMTP 配置 (复制为 .env 并填写)
QQ_EMAIL=your_qq_number@qq.com
QQ_AUTH_CODE=your_smtp_auth_code_here
TO_EMAIL=recipient@qq.com

# AI 市场评论 (DeepSeek API — 也可直接设置系统环境变量 DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=sk-your_deepseek_key
# 可选覆盖:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash

# 微信推送 (PushPlus, https://www.pushplus.plus 免费注册)
# PUSHPLUS_TOKEN=your_pushplus_token

# Web 仪表盘端口 (默认 8600; 8080 与 qBittorrent 冲突)
# DASH_PORT=8600
